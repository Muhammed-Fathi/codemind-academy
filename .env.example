# CodeMind Academy — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite connection string (used by Prisma)
# For production, switch to PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost:5432/codemind
DATABASE_URL="file:./db/custom.db"

# ── Application ──────────────────────────────────────────────────────────────
# Public URL of the deployed application (used for referral links, etc.)
NEXT_PUBLIC_URL="http://localhost:3000"

# ── Authentication ───────────────────────────────────────────────────────────
# The auth system uses cookie-based sessions stored in the database.
# No JWT_SECRET is required for the current implementation.
# If you switch to JWT, add: JWT_SECRET="your-super-secret-key-change-this"

# ── Security hash secret ─────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION (NODE_ENV=production). Keys the one-way hashes of
# client IP addresses (audit log / rate limiting) and device fingerprints
# (single-device session enforcement). Without it, those hashes would be
# computed with a predictable key.
#
#   * Production: the build and the server REFUSE TO START if this is missing,
#     shorter than 32 characters, or equal to the development placeholder.
#   * Development/test: optional; a non-secret dev fallback is used when unset.
#
# Generate a real value (never commit it):
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates existing device fingerprints (users may need to log
# in again) but does not affect passwords or reset tokens.
SECURITY_HASH_SECRET="REPLACE_WITH_openssl_rand_hex_32"

# Set to "1" ONLY on a CI build host that intentionally holds no production
# secrets. Skips the build-time SECURITY_HASH_SECRET check; the runtime server
# still enforces it at startup.
# SKIP_PRODUCTION_ENV_CHECK="1"

# ── AI / LLM (z-ai-web-dev-sdk) ─────────────────────────────────────────────
# The z-ai-web-dev-sdk is configured automatically in the sandbox environment.
# For production deployment, ensure the SDK credentials are available.
# No additional env vars are needed — the SDK handles auth internally.

# ── Payment Methods (Informational only — manual verification) ──────────────
# These are displayed in the UI. No payment gateway integration exists.
# INSTAPAY, VODAFONE_CASH, ETISALAT_CASH are the supported manual methods.

# ── Branding (Optional overrides — defaults in src/lib/brand.ts) ─────────────
# The following can be overridden in the database Settings table via Admin UI:
# - brand_name
# - brand_tagline
# - whatsapp_teacher
# - whatsapp_technical
# - whatsapp_subscription
# - academic_year
# - price_monthly, price_3months, price_6months, price_early_bird

# ═════════════════════════════════════════════════════════════════════════════
# 2026 Platform Upgrade — new variables
# ═════════════════════════════════════════════════════════════════════════════

# ── Private media storage ────────────────────────────────────────────────────
# Uploaded session videos and quiz camera snapshots are written OUTSIDE the web
# root under random keys and are only readable through /api/media/[id], which
# re-checks the caller's role on every request. Point this at a persistent
# volume — it must survive redeploys, and must NOT be served by nginx directly.
MEDIA_STORAGE_PATH="./storage/media"

# Upload size ceilings, in bytes. Requests above the limit are rejected before
# anything is written to disk.
MEDIA_MAX_VIDEO_BYTES="536870912"   # 512 MB
MEDIA_MAX_IMAGE_BYTES="5242880"     # 5 MB
# Phase 14 — session PDF uploads (Material → MediaAsset DOCUMENT).
MEDIA_MAX_PDF_BYTES="26214400"      # 25 MB

# ── Quiz camera evidence retention ───────────────────────────────────────────
# Snapshots captured during a quiz attempt are stamped with a retainUntil date
# = now + this many days, and are purged after it. Keep this as low as your
# academic-integrity policy allows: this is biometric personal data.
QUIZ_EVIDENCE_RETENTION_DAYS="30"

# ── Password reset ───────────────────────────────────────────────────────────
# Lifetime of an email reset link, in minutes.
PASSWORD_RESET_TTL_MINUTES="15"

# ── Teacher application (Phase 20) ───────────────────────────────────────────
# Lifetime of the single-use teacher activation link, in hours.
TEACHER_ACTIVATION_TTL_HOURS="72"

# ── Rate limiting (Phase 20) ─────────────────────────────────────────────────
# Shared, database-backed, per-user fixed-window limits for the abuse-sensitive
# endpoints. Each value is either `limit` or `limit/windowSec/blockSec`; a
# missing/blank value uses the built-in default, and an unparseable value is
# clamped to a safe bound (never disables the limiter).
#
#   RATE_LIMIT_HEARTBEAT         video playhead heartbeats (lesson + batch)
#   RATE_LIMIT_PROGRESS          lesson progress writes
#   RATE_LIMIT_OPEN              admin session-open ceremony
#   RATE_LIMIT_NOTIFICATION      admin notification broadcast
#   RATE_LIMIT_MATERIAL_DOWNLOAD authorized session PDF downloads
#   RATE_LIMIT_PDF_UPLOAD        admin session PDF uploads
#   RATE_LIMIT_TEACHER_APPLY     public teacher applications (per email)
#
# Examples (defaults shown):
# RATE_LIMIT_HEARTBEAT="300/60/60"
# RATE_LIMIT_PROGRESS="120/60/60"
# RATE_LIMIT_OPEN="20/60/300"
# RATE_LIMIT_NOTIFICATION="30/60/300"
# RATE_LIMIT_MATERIAL_DOWNLOAD="120/60/60"
# RATE_LIMIT_PDF_UPLOAD="30/60/300"
# RATE_LIMIT_TEACHER_APPLY="5/3600/3600"

# ── Content Security Policy (Phase 20) ───────────────────────────────────────
# The CSP is enforced in production and widened with 'unsafe-eval' (webpack
# HMR) in development only. Operators may roll back WITHOUT a redeploy:
#   CSP_REPORT_ONLY="1"  → emit Content-Security-Policy-Report-Only instead
#                          (observe violations before enforcing).
#   CSP_DISABLED="1"     → remove the CSP header entirely (last-resort escape
#                          hatch; not recommended).
# CSP_REPORT_ONLY="0"
# CSP_DISABLED="0"

# ── Gmail SMTP (password reset emails) ───────────────────────────────────────
# REQUIRED FOR PRODUCTION. With SMTP unconfigured, reset tokens are still
# created and validated correctly, but no email is ever delivered, so the flow
# cannot be completed by a real person.
#
# NEVER commit real values. Put them in .env (or .env.local) only:
#   - SMTP_USER    = the Gmail address you will send from
#   - SMTP_PASSWORD = a Gmail APP PASSWORD (NOT your normal Gmail password).
#                     16 chars, generated at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="YOUR_CODEMIND_GMAIL"
SMTP_PASSWORD="YOUR_GMAIL_APP_PASSWORD"
# Optional: the `From` header. Gmail only allows the authenticated address,
# so leave empty to default to SMTP_USER.
EMAIL_FROM=""
# Set to "1" only if you use implicit TLS on port 465 instead of STARTTLS on 587.
SMTP_SECURE="0"

# Recipient used by the local email test script (scripts/send-test-email.ts).
EMAIL_TEST_TO="you@example.com"

# Set to exactly "1" to log a REDACTED delivery record (masked destination
# only — never the token or credentials) when a message is queued. It is a
# diagnostic aid, NOT a delivery mechanism. Ignored when NODE_ENV=production.
DELIVERY_DEV_LOG="1"
