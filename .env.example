# CodeMind Academy — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite connection string (used by Prisma).
#
# WHERE THE FILE ACTUALLY LANDS: Prisma resolves a RELATIVE `file:` URL
# against the SCHEMA directory (`prisma/`), not the project root. So the value
# below creates/opens `<repo>/prisma/db/custom.db`. That is the file every
# `prisma` command (`db:push`, `db:migrate`, the seeder) and the running app
# use together — keep using relative URLs and they always agree.
#
# Use an absolute path when you need one specific location:
#   file:/srv/codemind/db/custom.db        (Linux/macOS)
#   file:C:/codemind/db/custom.db          (Windows)
#
# Local write-QA must use a local file: URL. NEVER point this at production
# Neon (or run registration/reset/seed write tests against production).
# For production, switch to PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost:5432/codemind
DATABASE_URL="file:./db/custom.db"

# ── Application ──────────────────────────────────────────────────────────────
# Public origin of the deployed application (used for referral links, password
# reset links and teacher activation links).
#
# REQUIRED IN PRODUCTION (NODE_ENV=production) — Phase 26G.
#   Until 26G every absolute link was built as
#   `process.env.NEXT_PUBLIC_URL || "http://localhost:3000"`. Unset in
#   production, that silently emailed password-reset and teacher-activation
#   links pointing at http://localhost:3000 — the mail is delivered, the token
#   is valid, and the link goes nowhere, with nothing in the logs to explain it.
#   * Production build + server startup now REFUSE to proceed with a missing,
#     blank, non-absolute, non-HTTPS or loopback value
#     (src/lib/app-url.ts + src/lib/env.ts), so the misconfiguration is caught
#     at deploy time instead of being discovered by a locked-out user.
#   * PRODUCTION IS HTTPS-ONLY. `https:` is the only accepted scheme. This
#     origin prefixes the password-reset and teacher-activation links, which
#     carry a single-use credential in the query string: over http that token
#     is readable and rewritable by anyone on the path, and any https->http
#     hop leaks it in a Referer. `http://<public-host>` is therefore a hard
#     build/boot failure, not a warning.
#   * The origin must be BARE: scheme + host (+ optional port, + optional base
#     path). Embedded credentials, a query string or a fragment are rejected —
#     any of them would silently corrupt or truncate the token that appUrl()
#     appends.
#   * It must be present in the BUILD environment as well as the runtime
#     environment: NEXT_PUBLIC_* is inlined into any CLIENT bundle that reads
#     it. (Verified on this build: no client component reads it today, so the
#     server keeps a runtime `process.env.NEXT_PUBLIC_URL` lookup — but a
#     future client-side reader would freeze the build-time value, so set it in
#     both places.)
#   * Use the real public https origin, e.g. https://codemind.academy
#     (a Vercel preview origin such as https://<project>.vercel.app is valid
#     too). HTTPS is mandatory, not merely preferred: the app emits HSTS and
#     the links carry reset tokens.
#   * On a CI host that intentionally holds no production configuration, set
#     SKIP_PRODUCTION_ENV_CHECK=1 (skips the BUILD check only) or supply a
#     disposable public origin; the runtime guard still enforces the real one.
#   * Development/test: optional; defaults to http://localhost:3000, unchanged.
#
# The value is PUBLIC by design (NEXT_PUBLIC_* reaches the browser bundle).
# Never put a secret here.
NEXT_PUBLIC_URL="http://localhost:3000"

# ── Authentication ───────────────────────────────────────────────────────────
# The auth system uses cookie-based sessions stored in the database.
# No JWT_SECRET is required for the current implementation.
# If you switch to JWT, add: JWT_SECRET="your-super-secret-key-change-this"

# ── Security hash secret ─────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION (NODE_ENV=production). Keys the one-way hashes of
# client IP addresses (audit log / rate limiting) and device fingerprints
# (single-device session enforcement). Without it, those hashes would be
# computed with a predictable key.
#
#   * Production: the build and the server REFUSE TO START if this is missing,
#     shorter than 32 characters, or equal to the development placeholder.
#   * Development/test: optional; a non-secret dev fallback is used when unset.
#
# Generate a real value (never commit it):
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates existing device fingerprints (users may need to log
# in again) but does not affect passwords or reset tokens.
SECURITY_HASH_SECRET="REPLACE_WITH_openssl_rand_hex_32"

# Set to "1" ONLY on a CI build host that intentionally holds no production
# secrets. Skips the build-time SECURITY_HASH_SECRET check; the runtime server
# still enforces it at startup.
# SKIP_PRODUCTION_ENV_CHECK="1"

# ── AI / LLM (z-ai-web-dev-sdk) ─────────────────────────────────────────────
# The z-ai-web-dev-sdk is configured automatically in the sandbox environment.
# For production deployment, ensure the SDK credentials are available.
# No additional env vars are needed — the SDK handles auth internally.

# ── Payment Methods (Informational only — manual verification) ──────────────
# These are displayed in the UI. No payment gateway integration exists.
# INSTAPAY, VODAFONE_CASH, ETISALAT_CASH are the supported manual methods.

# ── Branding (Optional overrides — defaults in src/lib/brand.ts) ─────────────
# The following can be overridden in the database Settings table via Admin UI:
# - brand_name
# - brand_tagline
# - whatsapp_teacher
# - whatsapp_technical
# - whatsapp_subscription
# - academic_year
# - price_monthly, price_3months, price_6months, price_early_bird

# ═════════════════════════════════════════════════════════════════════════════
# 2026 Platform Upgrade — new variables
# ═════════════════════════════════════════════════════════════════════════════

# ── Private media storage ────────────────────────────────────────────────────
# Uploaded session videos and quiz camera snapshots are written OUTSIDE the web
# root under random keys and are only readable through /api/media/[id], which
# re-checks the caller's role on every request. Point this at a persistent
# volume — it must survive redeploys, and must NOT be served by nginx directly.
#
# MEDIA_BACKEND selects the storage implementation behind src/lib/media.ts.
# Unset or empty means "local" (the historical behaviour, and the default).
# Supported values: "local", "s3". Any other value fails closed with a
# server-side error on the first storage operation and never silently falls
# back to the local filesystem. MEDIA_STORAGE_PATH below applies to the
# "local" backend; the R2_* variables below apply to the "s3" backend.
MEDIA_BACKEND="local"
MEDIA_STORAGE_PATH="./storage/media"

# ── Cloudflare R2 (S3-compatible) object storage ─────────────────────────────
# Used ONLY when MEDIA_BACKEND="s3". R2 stays PRIVATE: every READ is proxied
# by the server (Browser → CodeMind server → R2); no public bucket access, no
# presigned GET, no client-supplied keys. Large ADMIN uploads (session videos,
# lesson PDFs) may go direct: Browser → R2 via a SHORT-LIVED presigned PUT
# (Phase 23) — PUT-only, one exact server-generated key, minutes-short expiry,
# verified server-side before any DB row is created. These are SERVER-SIDE
# secrets — NEVER expose any of them via a NEXT_PUBLIC_* variable. Variable
# names only in this file; real values belong in your environment, never in
# the repo.
# R2_S3_ENDPOINT may be left empty to use the standard R2 endpoint derived
# from R2_ACCOUNT_ID.
#
# PHASE 26G — EXACT NAMES (verified against the shipped code, do not invent
# synonyms; a renamed variable is silently ignored and the backend then fails
# closed on the first storage operation):
#   * the backend selector is MEDIA_BACKEND="s3"  (above) — NOT STORAGE_BACKEND
#   * the endpoint override is R2_S3_ENDPOINT     — NOT R2_ENDPOINT
#   * R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET are
#     ALL mandatory when MEDIA_BACKEND="s3" (src/lib/media-s3.ts resolves them
#     and throws, naming the missing variable names only, if any is blank)
#   * R2_REGION defaults to "auto" (R2's region) — set it explicitly anyway
#   * these are SERVER-ONLY secrets; none of them may be a NEXT_PUBLIC_* var
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="codemind-academy-media"
R2_REGION="auto"
R2_S3_ENDPOINT=""

# Phase 23 — lifetime (seconds) of a presigned direct-upload PUT URL and its
# matching upload-intent token. Defaults to 600; clamped into [60, 900] so a
# bad value degrades to a short bound instead of disabling the expiry.
MEDIA_UPLOAD_PRESIGN_EXPIRES_SEC=""

# Upload size ceilings, in bytes. Requests above the limit are rejected before
# anything is written to disk.
MEDIA_MAX_VIDEO_BYTES="536870912"   # 512 MB
MEDIA_MAX_IMAGE_BYTES="5242880"     # 5 MB
# Phase 14 — session PDF uploads (Material → MediaAsset DOCUMENT).
MEDIA_MAX_PDF_BYTES="26214400"      # 25 MB

# ── Notification fan-out chunking (Phase 17) ─────────────────────────────────
# Rows per `Notification.createMany` chunk in the admin broadcast / session
# publication fan-out. Default 500, clamped to [1, 1000] — 500 rows binds
# 2,500 variables, ~13x headroom under BOTH the SQLite (32,766) and PostgreSQL
# (32,767) parameter ceilings. Leave unset unless you have measured a reason.
# A non-numeric or < 1 value is ignored, never fatal. (Phase 26G: this variable
# is read by src/lib/notify.ts but was missing from this file.)
# NOTIFICATION_FANOUT_CHUNK_SIZE="500"

# ── Quiz camera evidence retention ───────────────────────────────────────────
# Snapshots captured during a quiz attempt are stamped with a retainUntil date
# = now + this many days, and are purged after it. Keep this as low as your
# academic-integrity policy allows: this is biometric personal data.
QUIZ_EVIDENCE_RETENTION_DAYS="30"

# ── Password reset ───────────────────────────────────────────────────────────
# Lifetime of an email reset link, in minutes.
PASSWORD_RESET_TTL_MINUTES="15"

# ── Seeded (demo) account credentials ───────────────────────────────────────
# scripts/seed.ts NEVER uses a password that lives in this repository.
#
#   * Set here  → used verbatim, and never echoed back by the seeder.
#   * Unset + NODE_ENV=production → the seeder REFUSES to run (exit 1).
#   * Unset otherwise (local dev) → a random password is generated and printed
#     ONCE, for the database that was just seeded.
#
# Generate: openssl rand -hex 24     NEVER commit the values.
# SEED_ADMIN_PASSWORD=""
# SEED_DEMO_PASSWORD=""

# ── Login abuse limiting ────────────────────────────────────────────────────
# POST /api/auth/login is throttled on two independent, DB-backed buckets
# (the shared SecurityRateLimit table), because it is the one unauthenticated
# endpoint that mints a session:
#   login:id — per submitted email (hashed): 10 attempts / 15 min, 10 min block.
#              Cleared on a successful login, so this throttles attackers and
#              not people who mistype. Keyed on the email whether or not the
#              account exists, so it leaks nothing about account existence.
#   login:ip — per client IP (hashed with SECURITY_HASH_SECRET):
#              40 attempts / 10 min, 15 min block.
# The client IP is taken from X-Real-IP (set by the Caddy reverse proxy, which
# overwrites any client-supplied value) and only then from the first
# X-Forwarded-For hop — see clientIpFromHeaders() in src/lib/security.ts. IP
# buckets are abuse throttles only; they are never an authorization input.

# ── Teacher application (Phase 20) ───────────────────────────────────────────
# Lifetime of the single-use teacher activation link, in hours.
TEACHER_ACTIVATION_TTL_HOURS="72"

# ── Rate limiting (Phase 20) ─────────────────────────────────────────────────
# Shared, database-backed, per-user fixed-window limits for the abuse-sensitive
# endpoints. Each value is either `limit` or `limit/windowSec/blockSec`; a
# missing/blank value uses the built-in default, and an unparseable value is
# clamped to a safe bound (never disables the limiter).
#
#   RATE_LIMIT_HEARTBEAT         video playhead heartbeats (lesson + batch)
#   RATE_LIMIT_PROGRESS          lesson progress writes
#   RATE_LIMIT_OPEN              admin session-open ceremony
#   RATE_LIMIT_NOTIFICATION      admin notification broadcast
#   RATE_LIMIT_MATERIAL_DOWNLOAD authorized session PDF downloads
#   RATE_LIMIT_PDF_UPLOAD        admin session PDF uploads
#   RATE_LIMIT_TEACHER_APPLY     public teacher applications (per email)
#
# Examples (defaults shown):
# RATE_LIMIT_HEARTBEAT="300/60/60"
# RATE_LIMIT_PROGRESS="120/60/60"
# RATE_LIMIT_OPEN="20/60/300"
# RATE_LIMIT_NOTIFICATION="30/60/300"
# RATE_LIMIT_MATERIAL_DOWNLOAD="120/60/60"
# RATE_LIMIT_PDF_UPLOAD="30/60/300"
# RATE_LIMIT_TEACHER_APPLY="5/3600/3600"

# ── Content Security Policy (Phase 20) ───────────────────────────────────────
# The CSP is enforced in production and widened with 'unsafe-eval' (webpack
# HMR) in development only. Operators may roll back WITHOUT a redeploy:
#   CSP_REPORT_ONLY="1"  → emit Content-Security-Policy-Report-Only instead
#                          (observe violations before enforcing).
#   CSP_DISABLED="1"     → remove the CSP header entirely (last-resort escape
#                          hatch; not recommended).
# CSP_REPORT_ONLY="0"
# CSP_DISABLED="0"

# ── HTTP Strict Transport Security ──────────────────────────────────────────
# Emitted by next.config.ts for every documented deployment (TLS is terminated
# by Caddy / nginx / Vercel and HTTP is redirected to HTTPS). Browsers honour
# the header only on a secure response. `preload` is deliberately NOT set — it
# is a one-way door submitted to browser vendor lists.
# HSTS_DISABLED="0"

# ── Gmail SMTP (password reset emails) ───────────────────────────────────────
# REQUIRED FOR PRODUCTION. With SMTP unconfigured, reset tokens are still
# created and validated correctly, but no email is ever delivered, so the flow
# cannot be completed by a real person.
#
# NEVER commit real values. Put them in .env (or .env.local) only:
#   - SMTP_USER    = the Gmail address you will send from
#   - SMTP_PASSWORD = a Gmail APP PASSWORD (NOT your normal Gmail password).
#                     16 chars, generated at https://myaccount.google.com/apppasswords
#
# PHASE 26G — EXACT NAMES (verified against the shipped code):
#   * the password variable is SMTP_PASSWORD — NOT SMTP_PASS
#   * the sender identity is  EMAIL_FROM     — NOT SMTP_FROM (optional; when
#     empty it defaults to SMTP_USER, which is what Gmail requires anyway)
#   * all four of SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD must be
#     non-empty or `isSmtpConfigured()` is false: reset tokens are still
#     minted and validated correctly, but NO mail is ever delivered, so a real
#     user cannot complete the flow. src/lib/mailer.ts is the only module that
#     touches them and it never logs or returns their values.
#   * server-only secrets — never NEXT_PUBLIC_*, never client-imported.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="YOUR_CODEMIND_GMAIL"
SMTP_PASSWORD="YOUR_GMAIL_APP_PASSWORD"
# Optional: the `From` header. Gmail only allows the authenticated address,
# so leave empty to default to SMTP_USER.
EMAIL_FROM=""
# Set to "1" only if you use implicit TLS on port 465 instead of STARTTLS on 587.
SMTP_SECURE="0"

# Recipient used by the local email test script (scripts/send-test-email.ts).
EMAIL_TEST_TO="you@example.com"

# Set to exactly "1" to log a REDACTED delivery record (masked destination
# only — never the token or credentials) when a message is queued. It is a
# diagnostic aid, NOT a delivery mechanism. Ignored when NODE_ENV=production.
DELIVERY_DEV_LOG="1"

# ═════════════════════════════════════════════════════════════════════════════
# Phase 21 — Production database & storage
# ═════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL (production) ──────────────────────────────────────────────────
# Cutover target. The schema ships as prisma/schema.prisma (SQLite, dev) plus a
# DERIVED prisma/postgres/schema.prisma (regenerate with
# `node scripts/db/make-postgres-schema.mjs` — never edit by hand). The derived
# schema lives in its own directory so it owns its own migrations
# (prisma/postgres/migrations/). Production builds MUST generate the Prisma
# Client from it: `npm run build:postgres` (not `npm run build`, which
# generates the SQLite client for local development).
# Cutover procedure: docs/POSTGRES_CUTOVER_RUNBOOK.md.
# NEVER commit a real URL (it contains the password). Production form:
#   DATABASE_URL="postgresql://codemind:<password>@<host>:5432/codemind?sslmode=verify-full"
#
# PHASE 26G — WHY `sslmode=verify-full` AND NOT `sslmode=require`
#   `sslmode=require` means DIFFERENT things to the two PostgreSQL clients in
#   this repository, and the difference is a security downgrade waiting to
#   happen:
#     * Prisma (Rust connector) follows libpq semantics: `require` = encrypt,
#       DO NOT verify the server certificate or its hostname.
#     * node-postgres (`pg`, used by /api/cron/purge-evidence and by every
#       script under scripts/db/) currently treats `require` as `verify-full`
#       — but pg-connection-string >= 2.10 emits a SECURITY WARNING saying
#       that `prefer`/`require`/`verify-ca` are aliases for `verify-full` TODAY
#       and will adopt the WEAKER libpq semantics in pg v9.0.0.
#   So the same URL is strict in one client and will silently become lax in
#   the other after a dependency bump. `sslmode=verify-full` is unambiguous in
#   BOTH, today and after pg v9, and Neon serves publicly-issued certificates,
#   so verification succeeds against the Node trust store.
#   Verify on a disposable connection before go-live; if a client/proxy in
#   front of the DB terminates TLS in a way `verify-full` rejects, fall back
#   to `sslmode=require&channel_binding=require` (Neon's own hardening, which
#   binds the TLS channel to the password) rather than to a bare `require`.
#   Never set `sslmode=disable` / `allow` / `prefer` on a production URL.
# The cutover/migration scripts also accept --target / POSTGRES_URL so the
# app URL and the migration URL can differ during the freeze window.
# POSTGRES_URL=""

# ── Durable media volume ─────────────────────────────────────────────────────
# MEDIA_STORAGE_PATH (above) MUST point at a persistent volume in production
# (survives redeploys; never served directly by the proxy). Migration tool:
# `node scripts/media/migrate-media.mjs --source <old> --dest <new> --manifest …`
# (verifies SHA-256 per file; never deletes the source).

# ── Storage quotas ───────────────────────────────────────────────────────────
# Total volume cap over MEDIA_STORAGE_PATH. Unset / blank / "0" = unlimited
# (default — uploads behave exactly as before). When set, uploads that would
# exceed it are rejected with 413 before any byte is written. Plain bytes or a
# human size ("10GB", "512 MB"). Per-file caps stay in MEDIA_MAX_*_BYTES.
# MEDIA_QUOTA_BYTES=""

# ── Backup encryption ────────────────────────────────────────────────────────
# Passphrase for AES-256 backup encryption (scripts/db/backup-postgres.sh).
# From the secret manager / environment ONLY — never commit a value, never log
# it (scripts print only whether encryption is on). Unset = unencrypted dump
# (rely on filesystem permissions + volume encryption instead).
# BACKUP_PASSPHRASE=""

# ═════════════════════════════════════════════════════════════════════════════
# Phase 24 — Vercel retention cron
# ═════════════════════════════════════════════════════════════════════════════

# ── Vercel Cron bearer secret ────────────────────────────────────────────────
# Authorizes GET /api/cron/purge-evidence — the daily expired quiz-evidence
# retention purge, scheduled by vercel.json ("0 3 * * *", 03:00 UTC daily).
# The request must send:
#   Authorization: Bearer <CRON_SECRET>
#
#   * SERVER-ONLY. REQUIRED in production once the Vercel cron is enabled:
#     with CRON_SECRET missing/blank the route fails closed (503) and the
#     purge never runs.
#   * NEVER a NEXT_PUBLIC_* variable — it must not reach any client bundle.
#   * NEVER returned to clients and NEVER logged: the route answers fixed,
#     minimal bodies and compares the secret in constant time.
#   * Accepted ONLY in the Authorization header. The route does not read the
#     query string, and sessions/cookies are ignored — neither anonymous
#     requests nor logged-in users can trigger deletion.
#
# Generate (never commit the value):
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
