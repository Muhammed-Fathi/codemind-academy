# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Testing ──────────────────────────────────────────────────────────────────
/coverage

# ── Next.js ──────────────────────────────────────────────────────────────────
/.next/
/out/

# ── Production ───────────────────────────────────────────────────────────────
/build

# ── Environment Variables ───────────────────────────────────────────────────
# EVERY env file is ignored, not just `.env` and `.env.local`: the
# environment-specific variants (.env.test, .env.development, .env.production,
# .env.staging) hold the same secrets — production DB URLs, SMTP credentials —
# and the previous rules left them committable by accident.
.env
.env.*
# Keep the template committed.
!.env.example

# ── Database ─────────────────────────────────────────────────────────────────
*.db
*.db-journal
/db/

# ── Misc ─────────────────────────────────────────────────────────────────────
.DS_Store
*.pem
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
dev.log
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── IDE & Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ── Agent & Tool Directories (internal, not for GitHub) ─────────────────────
agent-ctx/
tool-results/
upload/
.zscripts/
.claude
.z-ai-config
local-*
prompt

# ── Skills Directory (internal tooling) ──────────────────────────────────────
/skills/

# ── Examples (development reference only) ───────────────────────────────────
/examples/

# Private media storage (MEDIA_STORAGE_PATH default).
# Uploaded session videos and quiz camera snapshots are user data and must
# NEVER be committed — they are large and, in the case of camera evidence,
# personal biometric data subject to a retention policy.
/storage/

# Phase 21 — production data artifacts (never commit: user data + credentials).
# Database backups, load manifests and media-migration manifests may contain
# personal data (national IDs, emails, camera evidence bytes). Keep them on the
# backup volume / secret manager only.
/backups/
*.dump
*.dump.enc
*.dump.sha256
*.pg-load.json
*-purge-metrics.json

# Phase 25 PR4 — pre-cutover inventory dumps. `scripts/phase25-pr4-inventory.mjs`
# writes these (row counts, ids and other production-shaped inventory for the
# Neon cutover) and docs/PHASE_25_PR4_CUTOVER_RUNBOOK.md names them explicitly.
# They are operational records, not source — never commit them.
inventory.json
inventory.pg.json

# Phase 12 verification scratch: the local Prisma engine mirror + compile
# harness used when binaries.prisma.sh is unreachable. Documented as
# deliberately uncommitted in docs/PHASE_12_FINAL_REPORT.md.
/.verify/
