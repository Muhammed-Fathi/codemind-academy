// ============================================================
// Platform upgrade 2026/2027 — new models
// ============================================================

/// A batch groups every student of one school type on one course, so a
/// session video is published ONCE and resolved for all eligible students.
model Batch {
  id          String         @id @default(cuid())
  name        String
  nameAr      String
  schoolType  SchoolType
  courseId    String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  course      Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  students    Student[]
  videos      SessionVideo[]

  @@unique([schoolType, courseId])
  @@index([schoolType])
}

/// Media stored ONCE (uploaded file or external URL). Never duplicated per student.
model MediaAsset {
  id            String         @id @default(cuid())
  kind          MediaKind      @default(VIDEO)
  storage       MediaStorage   @default(EXTERNAL_URL)
  /// Private storage key (uploads) — never a public URL.
  storageKey    String?
  /// External URL (YouTube / Vimeo / CDN) when storage = EXTERNAL_URL.
  externalUrl   String?
  mimeType      String?
  sizeBytes     Int?
  durationSec   Int?
  originalName  String?
  /// Visibility: PRIVATE assets are only reachable through an authorized route.
  isPrivate     Boolean        @default(false)
  createdById   String?
  createdAt     DateTime       @default(now())
  sessionVideos SessionVideo[]
  quizEvidence  QuizAttemptEvidence[]
  materials     Material[]
  /// Phase G — teacher assignment files referencing this asset.
  homeworkAttachments Homework[]
  /// Phase G — student submission files referencing this asset.
  homeworkSubmissions HomeworkSubmission[]

  @@index([kind])
  @@index([storage])
}

/// A session video published to a batch. One row per (batch, lesson-ish session).
model SessionVideo {
  id           String             @id @default(cuid())
  batchId      String
  lessonId     String?
  mediaAssetId String
  title        String
  titleAr      String
  description  String?
  /// Minimum watched percentage required to consider the video complete.
  requiredPercent Int             @default(95)
  /// Explicit per-video progression gate. When true — AND the video is
  /// published, track/batch-eligible and trackable (managed storage) — the
  /// canonical engine requires watchPercent >= requiredPercent. Default
  /// false: every pre-existing row stays OPTIONAL (additive-only, no backfill).
  isRequiredForProgression Boolean @default(false)
  isPublished  Boolean            @default(false)
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  batch        Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lesson       Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  media        MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  views        SessionVideoView[]

  @@index([batchId, isPublished])
  @@index([lessonId])
}

/// Per-student watch tracking of a batch session video (95% rule).
model SessionVideoView {
  id              String       @id @default(cuid())
  sessionVideoId  String
  studentId       String
  watchedSec      Int          @default(0)
  durationSec     Int          @default(0)
  percent         Int          @default(0)
  isCompleted     Boolean      @default(false)
  completedAt     DateTime?
  lastHeartbeatAt DateTime?
  video           SessionVideo @relation(fields: [sessionVideoId], references: [id], onDelete: Cascade)
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionVideoId, studentId])
  @@index([studentId])
  @@index([isCompleted])
}

/// Persisted mock-exam definition, bound to exactly one school-type bank.
model MockExam {
  id            String             @id @default(cuid())
  title         String
  titleAr       String
  description   String?
  schoolType    SchoolType
  courseId      String?
  questionCount Int                @default(10)
  durationMin   Int                @default(30)
  passMark      Int                @default(60)
  difficulty    String             @default("MIXED")
  /// RANDOM = sample the matching bank at attempt time; FIXED = use the pinned questions.
  selectionMode String             @default("RANDOM")
  isPublished   Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  course        Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions     MockExamQuestion[]
  attempts      ExamAttempt[]

  @@index([schoolType, isPublished])
}

/// Pinned questions for a FIXED mock exam. Deleting a question detaches the
/// link but never destroys historical ExamAttempt answer snapshots.
model MockExamQuestion {
  id             String        @id @default(cuid())
  mockExamId     String
  questionId     String?
  examQuestionId String?
  order          Int           @default(0)
  mockExam       MockExam      @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  question       Question?     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examQuestion   ExamQuestion? @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)

  @@unique([mockExamId, questionId])
  @@unique([mockExamId, examQuestionId])
  @@index([mockExamId])
}

/// Server-side device/session tracking (replaces the Setting-row hack).
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  /// SHA-256 of the session token — the raw token is only ever in the cookie.
  tokenHash    String    @unique
  /// Stable-ish device fingerprint (hash of UA + platform hints). Advisory only.
  deviceHash   String
  userAgent    String?
  ipHash       String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedReason String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([deviceHash])
}

/// Single-use, short-lived password reset token/OTP. Only hashes are stored.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  /// SHA-256 of the emailed token or the SMS OTP. Raw value is never persisted or logged.
  tokenHash  String    @unique
  channel    String    @default("EMAIL")
  /// Redacted destination for audit (e.g. "a***@mail.com" / "+2010****77").
  destinationMask String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

/// Phase 20 — a person's application to become a Teacher. The public flow
/// only ever creates a PENDING row here; the User (role TEACHER) is created
/// LATER, by the applicant themselves, through the single-use activation
/// token minted when an Admin approves. `userId` is therefore set only at
/// activation (never by the public submitter, never by the approver).
model TeacherApplication {
  id               String                   @id @default(cuid())
  /// Canonicalized (lowercased/trimmed) — one application per email identity.
  email            String                   @unique
  name             String
  phone            String?
  specialty        String?
  bio              String?
  status           TeacherApplicationStatus @default(PENDING)
  /// Optional admin note (e.g. rejection reason). Never shown to the applicant.
  adminNote        String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  /// The provisioned User, set only when the applicant completes activation.
  userId           String?                  @unique
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  activationTokens TeacherActivationToken[]

  @@index([status, createdAt])
}

/// Phase 20 — single-use teacher activation token (same architecture as
/// PasswordResetToken: SHA-256 stored, raw secret only ever in the email).
/// One live token per application at a time.
model TeacherActivationToken {
  id            String             @id @default(cuid())
  applicationId String
  tokenHash     String             @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime           @default(now())
  application   TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, usedAt])
  @@index([expiresAt])
}

/// Generic server-side rate limiter bucket (reset requests, OTP verification…).
model SecurityRateLimit {
  id          String   @id @default(cuid())
  bucket      String
  identifier  String
  count       Int      @default(0)
  windowStart DateTime @default(now())
  blockedUntil DateTime?

  @@unique([bucket, identifier])
  @@index([windowStart])
}

/// Security audit trail (never contains raw tokens/OTPs).
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  detail    String?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

/// Camera evidence captured during a quiz attempt (snapshots, private storage).
model QuizAttemptEvidence {
  id            String      @id @default(cuid())
  attemptId     String
  mediaAssetId  String?
  /// SNAPSHOT | STATUS — STATUS rows record camera state changes with no media.
  kind          String      @default("SNAPSHOT")
  status        String?
  capturedAt    DateTime    @default(now())
  /// Retention deadline; a cleanup job deletes rows past this date.
  retainUntil   DateTime?
  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  media         MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([attemptId, capturedAt])
  @@index([retainUntil])
}

/// Phase 13 — the administrative lifecycle of a Lesson. Independent from
/// student progression: `PUBLISHED` + LOCKED is a normal, expected state
/// (a session that is in the curriculum but whose prerequisites are not met).
enum LessonStatus {
  DRAFT
  READY
  PUBLISHED
}

enum CurriculumStatus {
  OFFICIAL
  LEGACY
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MaterialKind {
  GENERATED
  ADMIN_UPLOADED
}

enum SchoolType {
  ARABIC
  LANGUAGE
}

/// Phase 12 — the content-eligibility dimension of the ONE shared course.
///
/// There is exactly ONE course; `trackScope` decides WHICH students a piece of
/// session content belongs to. It is metadata on the shared academic skeleton,
/// NOT a second curriculum universe: the official curriculum stays 2 Parts /
/// 7 Units / 23 lessons regardless of how many scopes exist.
///
///   SHARED   → visible to ARABIC and LANGUAGE students
///   ARABIC   → visible to ARABIC students only
///   LANGUAGE → visible to LANGUAGE students only
///
/// Matching is enforced SERVER-SIDE and fails closed (see
/// src/lib/track-scope.ts). `SHARED` is the default because it is the
/// semantically correct value for every row that predates Phase 12: all
/// pre-existing content was authored for the whole cohort, with no
/// track-specific variants in the database at migration time.
enum TrackScope {
  SHARED
  ARABIC
  LANGUAGE
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED_MULTI_DEVICE
}

enum MediaKind {
  VIDEO
  IMAGE
  DOCUMENT
}

enum MediaStorage {
  EXTERNAL_URL
  LOCAL_PRIVATE
  S3
}

enum Role {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

/// Phase 20 — the public "become a teacher" application lifecycle.
/// PENDING → APPROVED → ACTIVATED, or PENDING/APPROVED → REJECTED.
/// A rejected applicant may re-apply, which re-opens the SAME row as PENDING.
enum TeacherApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVATED
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum HomeworkStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

enum ExamType {
  UNIT
  MONTHLY
  MOCK
  FINAL
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  INSTAPAY
  VODAFONE_CASH
  ETISALAT_CASH
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum NotificationType {
  NEW_LESSON
  NEW_QUIZ
  QUIZ_RESULT
  NEW_HOMEWORK
  HOMEWORK_DEADLINE
  UPCOMING_SESSION
  LOW_ATTENDANCE
  MONTHLY_REPORT
  SUBSCRIPTION_EXPIRATION
  ANNOUNCEMENT
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  /// Phase F — the live-session event family. SESSION_LINK is the STRUCTURED
  /// one (it carries `Notification.sessionId` and renders Join / Copy link);
  /// the other three are lifecycle events of the same event object.
  SESSION_SCHEDULED
  SESSION_LINK
  SESSION_RESCHEDULED
  SESSION_CANCELLED
  /// Phase F — the absence-review family (students, parents, admins).
  ABSENCE_FINALIZED
  ABSENCE_REASON_SUBMITTED
  ABSENCE_EXCUSED
  ABSENCE_UNEXCUSED
  /// Phase F — the "still no reason" reminder (idempotent per case per day).
  ABSENCE_REMINDER
}

/// Phase F — the ADMINISTRATIVE state machine of an absence case. Separate
/// from `AttendanceStatus` on purpose: the attendance FACT is always ABSENT;
/// this is what the academy decided to do about it.
///
///   PENDING_REASON     nobody (student or parent) has submitted a reason yet
///   PENDING_REVIEW     a reason exists; an admin must decide
///   EXCUSED            admin accepted the absence (no hold; Phase H still
///                      requires the missed session's academic completion)
///   UNEXCUSED          admin refused it (an ACTIVE AbsenceHold is created)
///   NO_ACTION_REQUIRED the case was withdrawn/superseded without a decision
///                      (e.g. the attendance row was corrected by an admin
///                      after the fact — never silently relabelled EXCUSED)
enum AbsenceReviewStatus {
  PENDING_REASON
  PENDING_REVIEW
  EXCUSED
  UNEXCUSED
  NO_ACTION_REQUIRED
}

/// Phase F — the hold state Phase H consumes. See `AbsenceHold`.
enum AbsenceHoldStatus {
  ACTIVE
  RESOLVED
}
