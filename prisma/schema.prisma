generator client {
  provider        = "prisma-client-js"
}


datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  phone         String?
  role          Role           @default(STUDENT)
  avatarUrl     String?
  isActive      Boolean        @default(true)
  status        AccountStatus  @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogs     AuditLog[]
  notifications Notification[]
  parent        Parent?
  payments      Payment[]
  student       Student?
  teacher       Teacher?
  sessions      UserSession[]
  resetTokens   PasswordResetToken[]
  securityEvents SecurityEvent[]

  @@index([role])
  @@index([status])
}

model Student {
  id                String               @id @default(cuid())
  userId            String               @unique
  grade             String               @default("2nd Secondary")
  schoolName        String?
  schoolType        String?
  nationalId        String?              @unique
  parentPhone       String?
  studentCode       String?              @unique
  groupId           String?
  batchId           String?
  enrolledAt        DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  attendances       Attendance[]
  examAttempts      ExamAttempt[]
  homeworkSubmits   HomeworkSubmission[]
  bookmarks         LessonBookmark[]
  notes             LessonNote[]
  lessonProgress    LessonProgress[]
  parentLinks       ParentStudentLink[]
  quizAttempts      QuizAttempt[]
  referralsReceived Referral[]           @relation("ReferredRelation")
  referralsMade     Referral[]           @relation("ReferrerRelation")
  group             Group?               @relation(fields: [groupId], references: [id])
  batch             Batch?               @relation(fields: [batchId], references: [id], onDelete: SetNull)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges            StudentBadge[]
  studyTasks        StudyTask[]
  subscription      Subscription?
  videoViews        SessionVideoView[]

  @@index([schoolType])
  @@index([groupId])
  @@index([batchId])
}

model StudentBadge {
  id        String   @id @default(cuid())
  studentId String
  code      String
  earnedAt  DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, code])
  @@index([studentId])
}

model Parent {
  id        String              @id @default(cuid())
  userId    String              @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  children  ParentStudentLink[]
}

model ParentStudentLink {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  relation  String   @default("parent")
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Teacher {
  id           String               @id @default(cuid())
  userId       String               @unique
  bio          String?
  specialty    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  groups       Group[]
  templates    LessonPlanTemplate[]
  sessions     LiveSession[]
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherNotes TeacherNote[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameAr      String
  description String
  iconUrl     String?
  color       String   @default("#10b981")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  groups      Group[]
  parts       Part[]
  batches     Batch[]
  mockExams   MockExam[]
}

model Part {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  titleAr     String
  order       Int
  description String?
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  units       Unit[]

  @@index([courseId])
}

model Unit {
  id      String  @id @default(cuid())
  partId  String
  title   String
  titleAr String
  order   Int
  icon    String?
  topics  Topic[]
  part    Part    @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
}

model Topic {
  id      String   @id @default(cuid())
  unitId  String
  title   String
  titleAr String
  order   Int
  lessons Lesson[]
  unit    Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
}

model Lesson {
  id            String           @id @default(cuid())
  topicId       String
  title         String
  titleAr       String
  order         Int
  description   String?
  summary       String?
  duration      Int              @default(90)
  isLocked      Boolean          @default(false)
  isPublished   Boolean          @default(true)
  videoUrl      String?
  pdfUrl        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  examQuestions ExamQuestion[]
  homeworks     Homework[]
  topic         Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  bookmarks     LessonBookmark[]
  notes         LessonNote[]
  progress      LessonProgress[]
  sessions      LiveSession[]
  quizzes       Quiz[]
  sessionVideos SessionVideo[]

  @@index([topicId])
}

model Group {
  id        String        @id @default(cuid())
  name      String
  courseId  String
  teacherId String?
  capacity  Int           @default(20)
  schedule  String        @default("Sat & Tue, 6:00 PM")
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  teacher   Teacher?      @relation(fields: [teacherId], references: [id])
  course    Course        @relation(fields: [courseId], references: [id])
  sessions  LiveSession[]
  students  Student[]

  @@index([courseId])
}

model LiveSession {
  id           String        @id @default(cuid())
  groupId      String
  teacherId    String?
  lessonId     String?
  title        String
  titleAr      String
  description  String?
  startAt      DateTime
  duration     Int           @default(120)
  meetingUrl   String?
  recordingUrl String?
  status       SessionStatus @default(SCHEDULED)
  createdAt    DateTime      @default(now())
  attendance   Attendance[]
  lesson       Lesson?       @relation(fields: [lessonId], references: [id])
  teacher      Teacher?      @relation(fields: [teacherId], references: [id])
  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([startAt])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  sessionId String
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now())
  session   LiveSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
  @@index([studentId])
}

model Quiz {
  id          String        @id @default(cuid())
  lessonId    String
  title       String
  titleAr     String
  description String?
  passMark    Int           @default(60)
  timeLimit   Int?
  order       Int           @default(0)
  questions   Question[]
  lesson      Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts    QuizAttempt[]

  @@index([lessonId])
}

model Question {
  id          String       @id @default(cuid())
  quizId      String?
  type        QuestionType @default(MCQ)
  prompt      String
  promptAr    String?
  options     String
  answer      String
  explanation String?
  difficulty  Difficulty   @default(MEDIUM)
  marks       Int          @default(1)
  schoolType  SchoolType?
  createdAt   DateTime     @default(now())
  quiz        Quiz?        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]
  mockExamLinks MockExamQuestion[]

  @@index([quizId])
  @@index([schoolType])
}

model QuizAttempt {
  id         String       @id @default(cuid())
  quizId     String
  studentId  String
  score      Int          @default(0)
  totalMarks Int          @default(0)
  percentage Int          @default(0)
  passed     Boolean      @default(false)
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  cameraStatus String     @default("NOT_REQUESTED")
  answers    QuizAnswer[]
  evidence   QuizAttemptEvidence[]
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz       Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, studentId])
  @@index([studentId])
}

model QuizAnswer {
  id         String      @id @default(cuid())
  attemptId  String
  questionId String
  selected   String
  isCorrect  Boolean     @default(false)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model Homework {
  id           String               @id @default(cuid())
  lessonId     String
  title        String
  titleAr      String
  instructions String?
  deadline     DateTime
  maxMarks     Int                  @default(10)
  createdAt    DateTime             @default(now())
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions  HomeworkSubmission[]

  @@index([lessonId])
}

model HomeworkSubmission {
  id          String         @id @default(cuid())
  homeworkId  String
  studentId   String
  content     String?
  fileUrl     String?
  submittedAt DateTime?
  grade       Int?
  feedback    String?
  status      HomeworkStatus @default(PENDING)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  homework    Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

model ExamQuestion {
  id          String     @id @default(cuid())
  lessonId    String?
  examType    ExamType   @default(UNIT)
  prompt      String
  promptAr    String?
  options     String
  answer      String
  explanation String?
  difficulty  Difficulty @default(MEDIUM)
  marks       Int        @default(2)
  schoolType  SchoolType?
  lesson      Lesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mockExamLinks MockExamQuestion[]

  @@index([lessonId])
  @@index([schoolType])
}

model LessonProgress {
  id                  String    @id @default(cuid())
  studentId           String
  lessonId            String
  progress            Int       @default(0)
  isCompleted         Boolean   @default(false)
  lastViewedAt        DateTime?
  // --- video watch tracking (server-verified, monotonic) ---
  videoDurationSec    Int       @default(0)
  videoWatchedSec     Int       @default(0)
  videoPercent        Int       @default(0)
  videoCompleted      Boolean   @default(false)
  videoCompletedAt    DateTime?
  lastHeartbeatAt     DateTime?
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
  @@index([videoCompleted])
}

model TeacherNote {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  note      String
  createdAt DateTime @default(now())
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id             String         @id @default(cuid())
  name           String
  nameAr         String
  durationMonths Int
  price          Float
  isPromo        Boolean        @default(false)
  isActive       Boolean        @default(true)
  description    String?
  createdAt      DateTime       @default(now())
  subscriptions  Subscription[]
}

model Subscription {
  id        String             @id @default(cuid())
  studentId String             @unique
  planId    String
  status    SubscriptionStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  payments  Payment[]
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])
  student   Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Float
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  reference      String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String?
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model LessonBookmark {
  id        String   @id @default(cuid())
  studentId String
  lessonId  String
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
}

model LessonNote {
  id        String   @id @default(cuid())
  studentId String
  lessonId  String
  content   String
  color     String   @default("amber")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model ExamAttempt {
  id            String    @id @default(cuid())
  studentId     String
  mockExamId    String?
  schoolType    SchoolType?
  examType      String    @default("MOCK")
  questionCount Int
  durationMin   Int
  score         Int       @default(0)
  totalMarks    Int       @default(0)
  percentage    Int       @default(0)
  passed        Boolean   @default(false)
  answers       String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mockExam      MockExam? @relation(fields: [mockExamId], references: [id], onDelete: SetNull)

  @@index([studentId, examType])
  @@index([finishedAt])
  @@index([mockExamId])
}

model Coupon {
  id          String             @id @default(cuid())
  code        String             @unique
  type        String             @default("PERCENTAGE")
  value       Float
  maxUses     Int                @default(100)
  usedCount   Int                @default(0)
  validFrom   DateTime           @default(now())
  validUntil  DateTime?
  isActive    Boolean            @default(true)
  description String?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  paymentId String?
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
}

model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referredId  String
  rewardType  String    @default("XP")
  rewardValue Int       @default(50)
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  referred    Student   @relation("ReferredRelation", fields: [referredId], references: [id], onDelete: Cascade)
  referrer    Student   @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
}

model StudyTask {
  id            String   @id @default(cuid())
  studentId     String
  title         String
  description   String?
  lessonId      String?
  scheduledDate DateTime
  durationMin   Int      @default(60)
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, scheduledDate])
}

model NotificationPreference {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  newLesson              Boolean  @default(true)
  newQuiz                Boolean  @default(true)
  quizResult             Boolean  @default(true)
  newHomework            Boolean  @default(true)
  homeworkDeadline       Boolean  @default(true)
  upcomingSession        Boolean  @default(true)
  lowAttendance          Boolean  @default(true)
  monthlyReport          Boolean  @default(true)
  subscriptionExpiration Boolean  @default(true)
  announcements          Boolean  @default(true)
  emailEnabled           Boolean  @default(false)
  pushEnabled            Boolean  @default(true)
  quietHoursStart        String?
  quietHoursEnd          String?
  updatedAt              DateTime @updatedAt
}

model LessonPlanTemplate {
  id          String   @id @default(cuid())
  teacherId   String?
  title       String
  titleAr     String
  description String?
  duration    Int      @default(90)
  objectives  String
  materials   String
  activities  String
  homework    String?
  assessment  String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

// ============================================================
// Platform upgrade 2026/2027 — new models
// ============================================================

/// A batch groups every student of one school type on one course, so a
/// session video is published ONCE and resolved for all eligible students.
model Batch {
  id          String         @id @default(cuid())
  name        String
  nameAr      String
  schoolType  SchoolType
  courseId    String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  course      Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  students    Student[]
  videos      SessionVideo[]

  @@unique([schoolType, courseId])
  @@index([schoolType])
}

/// Media stored ONCE (uploaded file or external URL). Never duplicated per student.
model MediaAsset {
  id            String         @id @default(cuid())
  kind          MediaKind      @default(VIDEO)
  storage       MediaStorage   @default(EXTERNAL_URL)
  /// Private storage key (uploads) — never a public URL.
  storageKey    String?
  /// External URL (YouTube / Vimeo / CDN) when storage = EXTERNAL_URL.
  externalUrl   String?
  mimeType      String?
  sizeBytes     Int?
  durationSec   Int?
  originalName  String?
  /// Visibility: PRIVATE assets are only reachable through an authorized route.
  isPrivate     Boolean        @default(false)
  createdById   String?
  createdAt     DateTime       @default(now())
  sessionVideos SessionVideo[]
  quizEvidence  QuizAttemptEvidence[]

  @@index([kind])
  @@index([storage])
}

/// A session video published to a batch. One row per (batch, lesson-ish session).
model SessionVideo {
  id           String             @id @default(cuid())
  batchId      String
  lessonId     String?
  mediaAssetId String
  title        String
  titleAr      String
  description  String?
  /// Minimum watched percentage required to consider the video complete.
  requiredPercent Int             @default(95)
  isPublished  Boolean            @default(false)
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  batch        Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lesson       Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  media        MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  views        SessionVideoView[]

  @@index([batchId, isPublished])
  @@index([lessonId])
}

/// Per-student watch tracking of a batch session video (95% rule).
model SessionVideoView {
  id              String       @id @default(cuid())
  sessionVideoId  String
  studentId       String
  watchedSec      Int          @default(0)
  durationSec     Int          @default(0)
  percent         Int          @default(0)
  isCompleted     Boolean      @default(false)
  completedAt     DateTime?
  lastHeartbeatAt DateTime?
  video           SessionVideo @relation(fields: [sessionVideoId], references: [id], onDelete: Cascade)
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionVideoId, studentId])
  @@index([studentId])
  @@index([isCompleted])
}

/// Persisted mock-exam definition, bound to exactly one school-type bank.
model MockExam {
  id            String             @id @default(cuid())
  title         String
  titleAr       String
  description   String?
  schoolType    SchoolType
  courseId      String?
  questionCount Int                @default(10)
  durationMin   Int                @default(30)
  passMark      Int                @default(60)
  difficulty    String             @default("MIXED")
  /// RANDOM = sample the matching bank at attempt time; FIXED = use the pinned questions.
  selectionMode String             @default("RANDOM")
  isPublished   Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  course        Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions     MockExamQuestion[]
  attempts      ExamAttempt[]

  @@index([schoolType, isPublished])
}

/// Pinned questions for a FIXED mock exam. Deleting a question detaches the
/// link but never destroys historical ExamAttempt answer snapshots.
model MockExamQuestion {
  id             String        @id @default(cuid())
  mockExamId     String
  questionId     String?
  examQuestionId String?
  order          Int           @default(0)
  mockExam       MockExam      @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  question       Question?     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examQuestion   ExamQuestion? @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)

  @@unique([mockExamId, questionId])
  @@unique([mockExamId, examQuestionId])
  @@index([mockExamId])
}

/// Server-side device/session tracking (replaces the Setting-row hack).
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  /// SHA-256 of the session token — the raw token is only ever in the cookie.
  tokenHash    String    @unique
  /// Stable-ish device fingerprint (hash of UA + platform hints). Advisory only.
  deviceHash   String
  userAgent    String?
  ipHash       String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedReason String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([deviceHash])
}

/// Single-use, short-lived password reset token/OTP. Only hashes are stored.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  /// SHA-256 of the emailed token or the SMS OTP. Raw value is never persisted or logged.
  tokenHash  String    @unique
  channel    String    @default("EMAIL")
  /// Redacted destination for audit (e.g. "a***@mail.com" / "+2010****77").
  destinationMask String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

/// Generic server-side rate limiter bucket (reset requests, OTP verification…).
model SecurityRateLimit {
  id          String   @id @default(cuid())
  bucket      String
  identifier  String
  count       Int      @default(0)
  windowStart DateTime @default(now())
  blockedUntil DateTime?

  @@unique([bucket, identifier])
  @@index([windowStart])
}

/// Security audit trail (never contains raw tokens/OTPs).
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  detail    String?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

/// Camera evidence captured during a quiz attempt (snapshots, private storage).
model QuizAttemptEvidence {
  id            String      @id @default(cuid())
  attemptId     String
  mediaAssetId  String?
  /// SNAPSHOT | STATUS — STATUS rows record camera state changes with no media.
  kind          String      @default("SNAPSHOT")
  status        String?
  capturedAt    DateTime    @default(now())
  /// Retention deadline; a cleanup job deletes rows past this date.
  retainUntil   DateTime?
  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  media         MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([attemptId, capturedAt])
  @@index([retainUntil])
}

