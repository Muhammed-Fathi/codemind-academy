generator client {
  provider        = "prisma-client-js"
}


datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  phone         String?
  role          Role           @default(STUDENT)
  avatarUrl     String?
  isActive      Boolean        @default(true)
  status        AccountStatus  @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogs     AuditLog[]
  notifications Notification[]
  parent        Parent?
  payments      Payment[]
  student       Student?
  teacher       Teacher?
  sessions      UserSession[]
  resetTokens   PasswordResetToken[]
  securityEvents SecurityEvent[]
  /// Phase 26D — the Admin's audit trail of retry permissions they issued.
  grantedQuizRetries QuizRetryGrant[] @relation("QuizRetryGrantGranter")
  /// Phase G — homework grades this user wrote (grader identity).
  homeworkGraded HomeworkSubmission[] @relation("HomeworkGrader")

  @@index([role])
  @@index([status])
}

model Student {
  id                String               @id @default(cuid())
  userId            String               @unique
  grade             String               @default("2nd Secondary")
  schoolName        String?
  /// Phase 12: constrained from a free-form String to the `SchoolType` enum.
  /// Still NULLABLE on purpose — "unspecified" is a real, first-class state
  /// (the admin students screen has an UNSPECIFIED tab and registration is
  /// not the only way a student row is born). A NULL school type FAILS CLOSED
  /// for track purposes: the student sees SHARED content only, never
  /// ARABIC/LANGUAGE-specific content. See src/lib/track-scope.ts.
  schoolType        SchoolType?
  nationalId        String?              @unique
  parentPhone       String?
  studentCode       String?              @unique
  groupId           String?
  batchId           String?
  enrolledAt        DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  attendances       Attendance[]
  examAttempts      ExamAttempt[]
  homeworkSubmits   HomeworkSubmission[]
  bookmarks         LessonBookmark[]
  notes             LessonNote[]
  lessonProgress    LessonProgress[]
  parentLinks       ParentStudentLink[]
  /// Phase F — administrative absence cases + their holds (see AbsenceReview).
  absenceReviews    AbsenceReview[]
  absenceHolds      AbsenceHold[]
  /// Phase H — admin-issued progression overrides targeting this student.
  /// An override is an access EXCEPTION (an overlay on the canonical engine),
  /// never a rewrite of academic facts: quiz passes, homework submissions,
  /// video completion and attendance history are untouched by it.
  progressionOverrides ProgressionOverride[]
  quizAttempts      QuizAttempt[]
  /// Phase 26D — Admin-issued retry permissions targeting this student.
  retryGrants       QuizRetryGrant[]
  referralsReceived Referral[]           @relation("ReferredRelation")
  referralsMade     Referral[]           @relation("ReferrerRelation")
  group             Group?               @relation(fields: [groupId], references: [id])
  batch             Batch?               @relation(fields: [batchId], references: [id], onDelete: SetNull)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges            StudentBadge[]
  studyTasks        StudyTask[]
  subscription      Subscription?
  videoViews        SessionVideoView[]
  enrollments       Enrollment[]

  @@index([schoolType])
  @@index([groupId])
  @@index([batchId])
}

model StudentBadge {
  id        String   @id @default(cuid())
  studentId String
  code      String
  earnedAt  DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, code])
  @@index([studentId])
}

model Parent {
  id        String              @id @default(cuid())
  userId    String              @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  children  ParentStudentLink[]
}

model ParentStudentLink {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  relation  String   @default("parent")
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Teacher {
  id           String               @id @default(cuid())
  userId       String               @unique
  bio          String?
  specialty    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  groups       Group[]
  templates    LessonPlanTemplate[]
  sessions     LiveSession[]
  /// Phase F — sessions where this teacher is the SUBSTITUTE (session-scoped
  /// authority only; never group/course ownership).
  substituteSessions LiveSession[] @relation("LiveSessionSubstitute")
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherNotes TeacherNote[]
}

/// DEPRECATED / FUTURE SCHEMA — NOT USED BY ANY APPLICATION CODE.
///
/// Phase 12 verdict (docs/PHASE_12_TRACK_ARCHITECTURE.md): track eligibility
/// is modelled as `TrackScope` metadata on the shared curriculum, keyed off
/// `Student.schoolType`. A `Track` ENTITY would only ever hold two rows
/// (ARABIC / LANGUAGE) that duplicate the `SchoolType` enum, and turning it
/// into the access gate would mean a second, parallel enrollment system next
/// to the group-derived one — the exact hybrid the platform must not have.
///
/// Kept (not dropped) because dropping it is destructive and buys nothing:
/// it is referenced by `Course.trackId` / `Enrollment.trackId`, both of which
/// are NULL/unused. No route, lib or script reads or writes this model.
model Track {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  nameAr      String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  courses     Course[]
  enrollments Enrollment[]
}

/// DEPRECATED / DEAD SCHEMA — NOT USED BY ANY APPLICATION CODE.
///
/// Phase 12 verdict: `Group -> Course` remains the SINGLE enrollment gate
/// (`getEnrollment` / `canAccessCourse` in src/lib/enrollment.ts). This table
/// is never read or written anywhere in src/ or scripts/, and it has never
/// been backfilled.
///
/// It is deliberately NOT adopted: adopting it would require backfilling every
/// student and cutting every access check over in one coherent move, and it
/// would add a second source of truth for "is this student enrolled". Leaving
/// it half-used is the worse outcome, so it is formally declared dead schema.
/// Kept (not dropped) because a DROP is destructive and unnecessary.
///
/// NOTE: the `Enrollment` TYPE exported by src/lib/enrollment.ts is an
/// unrelated in-memory projection of the group-derived enrollment — it is not
/// this model.
model Enrollment {
  id        String       @id @default(cuid())
  studentId String
  courseId  String
  trackId   String
  status    EnrollmentStatus @default(ACTIVE)
  startsAt  DateTime     @default(now())
  endsAt    DateTime?
  createdAt DateTime     @default(now())
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  track     Track        @relation(fields: [trackId], references: [id], onDelete: Restrict)
  @@unique([studentId, courseId, trackId])
  @@index([courseId, trackId, status])
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameAr      String
  description String
  iconUrl     String?
  color       String   @default("#10b981")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  groups      Group[]
  parts       Part[]
  /// DEAD SCHEMA (Phase 12 verdict): always NULL, never read or written. The
  /// course is SHARED by both school types by design; track eligibility lives
  /// on the content (Lesson/Quiz/Homework.trackScope), not on the course.
  trackId     String?
  track       Track?       @relation(fields: [trackId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  batches     Batch[]
  mockExams   MockExam[]
}

model Part {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  titleAr     String
  order       Int
  description String?
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  units       Unit[]

  @@index([courseId])
}

model Unit {
  id      String  @id @default(cuid())
  partId  String
  title   String
  titleAr String
  order   Int
  icon    String?
  topics  Topic[]
  lessons Lesson[]
  part    Part    @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
}

model Topic {
  id      String   @id @default(cuid())
  unitId  String
  title   String
  titleAr String
  order   Int
  lessons Lesson[]
  unit    Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
}

model Lesson {
  id            String           @id @default(cuid())
  topicId       String?
  unitId        String?
  officialCode  String?          @unique
  curriculumStatus CurriculumStatus @default(LEGACY)
  /// Phase 12 — which school type this session belongs to. Track metadata,
  /// not a second curriculum: officialCode stays UNIQUE, so a track-specific
  /// lesson can never create a duplicate official row.
  trackScope    TrackScope       @default(SHARED)
  /// Phase 13 — THE administrative lifecycle of the session and the ONLY
  /// lifecycle source of truth. `DRAFT → READY → PUBLISHED` is an editorial
  /// chain owned by the admin OPEN ceremony
  /// (`src/lib/session-lifecycle.ts`, `POST /api/admin/lessons/[id]/open`);
  /// it is ORTHOGONAL to student progression (LOCKED/UNLOCKED/COMPLETED is
  /// derived per student by `src/lib/session-progress.ts` and is never
  /// stored here). `PUBLISHED` = eligible for the student curriculum
  /// universe; it does NOT mean unlocked, completed, or prerequisite-free.
  /// `DRAFT`/`READY` are admin-visible only: they never enter the student
  /// universe, the course tree, prev/next, dashboards or reports.
  /// Read the phase doc before changing any of this:
  /// `docs/PHASE_13_SESSION_LIFECYCLE.md`.
  status        LessonStatus     @default(DRAFT)
  title         String
  titleAr       String
  order         Int
  description   String?
  summary       String?
  duration      Int              @default(90)
  /// DEPRECATED (Phase 13) — inert legacy metadata, never revived. Lock
  /// state is DERIVED from progression (`unlocked = eligibility`), so this
  /// column is not read by any authorization, progression or visibility
  /// path and must never be used as one. Not written by the reconciler or by
  /// the lifecycle module any more. Drop it once no external consumer
  /// (raw SQL, exports) references it.
  isLocked      Boolean          @default(false)
  /// DEPRECATED (Phase 13) — read-only compatibility mirror of
  /// `status == PUBLISHED`, kept in sync by `src/lib/session-lifecycle.ts`,
  /// which is its ONLY writer. Nothing derives lifecycle behaviour from it
  /// any more: every former reader (progression universe, course tree,
  /// prev/next, dashboards, parent reports, reconciler) now reads `status`.
  /// It exists so external/legacy consumers and raw SQL keep working until a
  /// later phase drops the column; see `docs/PHASE_13_SESSION_LIFECYCLE.md`
  /// §"isPublished". Its historical `true` column default is INERT (kept so
  /// the column DDL needs no rebuild): every write path sets the mirror from
  /// `src/lib/session-lifecycle.ts`, and a lesson with no lifecycle write is
  /// DRAFT because `status` defaults to DRAFT at the database level.
  isPublished   Boolean          @default(true)
  videoUrl      String?
  pdfUrl        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  examQuestions ExamQuestion[]
  homeworks     Homework[]
  topic         Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  unit          Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  materials     Material[]
  bookmarks     LessonBookmark[]
  notes         LessonNote[]
  progress      LessonProgress[]
  sessions      LiveSession[]
  quizzes       Quiz[]
  sessionVideos SessionVideo[]
  /// Phase 13 — the publication anchor of the OPEN ceremony (idempotency +
  /// the state Phase 17 notification fan-out consumes). Optional: a lesson
  /// that has never been opened through the ceremony has none.
  publication   SessionPublication?
  /// Phase H — admin progression overrides granting access to this lesson.
  progressionOverrides ProgressionOverride[]

  @@index([topicId])
  @@index([unitId, order])
  @@index([status])
}

/// Phase 13 — the publication anchor of the OPEN ceremony.
///
/// WHY THIS TABLE EXISTS (and why nothing bigger does)
///   Lesson.status is the lifecycle source of truth and is itself enough to
///   make `POST /api/admin/lessons/[id]/open` idempotent. This row adds the
///   two things `status` cannot express:
///     1. WHICH curriculum segment was opened, and when — `lessonId` is
///        UNIQUE, which is the database-level idempotency key the roadmap asks
///        for as `(lessonId, segment)`; it collapses to `(lessonId)` on purpose
///        (see `segment` below), so a retried ceremony can never create a
///        second publication of the same lesson;
///     2. the state Phase 17's notification fan-out must consume (and
///        deduplicate against). Phase 13 deliberately wrote NO notifications
///        and no counters; Phase 17 (migration
///        20260911000000_phase17_session_notifications) then added the
///        `notifiedCount`/`notifiedAt` delivery counters below, maintained
///        only by `src/lib/session-notifications.ts`.
///   Every other lifecycle *event* (stage, unpublish, refusal) is recorded in
///   the platform's existing `AuditLog`, so there is no second event table.
///
/// A row here means "this lesson was opened through the ceremony". Backfilled
/// PUBLISHED rows (Phase 13 migration) deliberately have no row: their
/// publication predates the ceremony and no honest timestamp exists for them.
model SessionPublication {
  id                String     @id @default(cuid())
  /// The lesson this publication belongs to — and the idempotency key. One row
  /// per lesson because publication is a LESSON-level decision: the roadmap's
  /// `(lessonId, segment)` key deliberately collapses to `(lessonId)`, because
  /// a per-segment key would be the first per-track publication state
  /// (`PUBLISHED_ARABIC` vs `PUBLISHED_LANGUAGE`) and Phase 13 forbids one.
  lessonId          String     @unique
  /// The lesson's trackScope at publication time — recorded for audit and for
  /// Phase 17's targeting, NOT a second lifecycle dimension. `status` stays
  /// the only thing that decides visibility; `segment` never gates access.
  segment           TrackScope @default(SHARED)
  publishedAt       DateTime   @default(now())
  /// Cuid of the admin User who performed the ceremony. A plain column, NOT a
  /// relation: deleting a user must never rewrite curriculum history.
  publishedByUserId String?
  /// Phase 17: rows of the NEW_LESSON publication notification this anchor has
  /// delivered so far — the DB-truth cumulative count maintained by the
  /// fan-out in src/lib/session-notifications.ts. Capped by the number of
  /// DISTINCT users ever eligible (the per-user dedupe is (type, link) so the
  /// count can never exceed one row per user per publication, and a retry
  /// either grows it toward the eligible set or leaves it unchanged).
  notifiedCount     Int        @default(0)
  /// Phase 17: timestamp of the most recent fan-out run that delivered at
  /// least one row. NULL means no delivery has happened yet (the published
  /// state itself is real regardless — see Lesson.status).
  notifiedAt        DateTime?
  lesson            Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
}

model Group {
  id        String        @id @default(cuid())
  name      String
  courseId  String
  teacherId String?
  capacity  Int           @default(20)
  schedule  String        @default("Sat & Tue, 6:00 PM")
  isActive  Boolean       @default(true)
  /// Phase 26B (owner-approved): the group's explicit student AUDIENCE —
  /// which school type this teaching group is sold/assigned to.
  ///
  ///   ARABIC / LANGUAGE → the group's audience; the ONLY values a
  ///     student-facing group may carry. Enforced on every write path
  ///     (admin create/edit, enroll submission, payment approval, direct
  ///     admin student assignment) and on every student read (the picker
  ///     serves exact-match groups only).
  ///
  ///   NULL → UNCLASSIFIED. The transitional value for rows that predate
  ///     this field (the migration is additive and invents NO
  ///     classification for existing groups). An unclassified group is
  ///     FAIL-CLOSED everywhere: never listed to students, never
  ///     enrollable, never approvable into, and a populated one cannot be
  ///     classified until its students are compatible. An admin must
  ///     classify it explicitly before it can be sold again.
  ///
  ///   SHARED → valid for CONTENT architecture (Lesson/Quiz/Homework) but
  ///     deliberately NOT part of the group business model at launch: no
  ///     proven SHARED-group requirement exists, so write paths reject
  ///     SHARED for groups and student surfaces never match it (eligibility
  ///     is EXACT schoolType equality, not the wider content predicate).
  ///
  /// This is `TrackScope?` (no duplicate enum) but group eligibility NEVER
  /// uses the content-side "SHARED is eligible for everyone" rule — see
  /// `groupTrackScopeEligible` in src/lib/track-scope.ts.
  trackScope TrackScope?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  teacher   Teacher?      @relation(fields: [teacherId], references: [id])
  course    Course        @relation(fields: [courseId], references: [id])
  sessions  LiveSession[]
  students  Student[]
  /// Phase F — the group's absence-review cases (operational queues).
  absenceReviews AbsenceReview[]

  @@index([courseId])
  @@index([trackScope])
}

model Material {
  id          String       @id @default(cuid())
  lessonId    String
  kind        MaterialKind @default(GENERATED)
  title       String
  storageKey  String?
  mediaAssetId String?
  isActive    Boolean      @default(true)
  /// Phase 14 — track eligibility of this material, independent of (but never
  /// wider than is useful for) its lesson's trackScope. A LANGUAGE PDF on a
  /// SHARED lesson is served to LANGUAGE students only; SHARED material is
  /// visible to both tracks. Matching is enforced server-side via
  /// `src/lib/session-materials.ts` and fails closed.
  trackScope  TrackScope   @default(SHARED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  media       MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  @@index([lessonId, isActive])
  @@index([lessonId, trackScope, isActive])
}

/// LiveSession — a SCHEDULED LIVE MEETING of an academic Lesson for a Group.
///
/// Phase F makes this the authoritative live-teaching event of the platform.
/// It stays a SEPARATE model from `Lesson` on purpose and that is not
/// negotiable: `Lesson` (Course → Part → Unit → Lesson) is the academic
/// content unit with its own lifecycle (`LessonStatus`), readiness contract
/// and per-student progression; a `LiveSession` is the calendar event that
/// teachers and admins schedule against it. One Lesson has many LiveSessions
/// (original + make-up/rescheduled), and a LiveSession may carry no Lesson at
/// all (a legacy/extra class), so they must never be merged.
///
/// LIFECYCLE (no new enum — the existing `SessionStatus` covers it):
///   SCHEDULED → LIVE → COMPLETED, or SCHEDULED/LIVE → CANCELLED.
///   RESCHEDULED is deliberately NOT a status: a rescheduled session is still
///   a SCHEDULED session, and "it was rescheduled" is an EVENT recorded by
///   `rescheduleCount` / `lastRescheduledAt` / `originalStartAt` plus the
///   AuditLog. Adding a RESCHEDULED status would make the state machine
///   ambiguous (is a rescheduled session live? cancellable? attendance-able?)
///   and would force every reader to treat two states as one.
///
/// END TIME is DERIVED, never stored: `endsAt = startAt + duration` minutes
/// (`sessionEndsAt()` in src/lib/live-session-policy.ts). The platform already
/// schedules with (startAt, duration) pairs and every consumer must agree on
/// one arithmetic, so a second stored end timestamp would be a second source
/// of truth for the attendance lock and the join window.
model LiveSession {
  id           String        @id @default(cuid())
  groupId      String
  teacherId    String?
  lessonId     String?
  title        String
  titleAr      String
  description  String?
  startAt      DateTime
  duration     Int           @default(120)
  meetingUrl   String?
  recordingUrl String?
  status       SessionStatus @default(SCHEDULED)
  createdAt    DateTime      @default(now())
  /// Phase F — who created the event. A plain column, NOT a relation:
  /// deleting a user must never rewrite session history (same policy as
  /// `SessionPublication.publishedByUserId`).
  createdByUserId String?
  /// Phase F — the last lifecycle flip (SCHEDULED→LIVE→COMPLETED/CANCELLED).
  statusChangedAt       DateTime?
  statusChangedByUserId String?
  /// Phase F — the "the class actually happened" indicator teachers set when
  /// they START the live period. NULL = the teacher never started it, which is
  /// what feeds the TEACHER_NO_SHOW_REVIEW queue (Phase F never invents
  /// student absences from a missing teacher action).
  conductedAt DateTime?
  /// Phase F — explicit end of the live period marked by the teacher. It is
  /// OPERATIONAL INFORMATION ONLY: it never shortens the attendance window
  /// (which is derived from the schedule, so every role computes the same
  /// lock instant) and it never deletes attendance.
  endedAt DateTime?
  /// Phase F — cancellation ceremony.
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelReason      String?
  /// Phase F — reschedule ceremony. `originalStartAt` keeps the FIRST
  /// scheduled instant forever (never overwritten by a second reschedule) so
  /// the history of the event survives; `rescheduleCount` counts ceremonies.
  rescheduleCount      Int       @default(0)
  lastRescheduledAt    DateTime?
  rescheduledByUserId  String?
  originalStartAt      DateTime?
  /// Phase F — SUBSTITUTE TEACHER, session-scoped ONLY. Assigning a
  /// substitute never touches `Group.teacherId`/`Course`/`Teacher.groups`:
  /// the substitute holds authority for THIS LiveSession (view, join, start,
  /// take attendance within the window) and nothing else.
  substituteTeacherId       String?
  substituteAssignedAt      DateTime?
  substituteAssignedByUserId String?
  /// Phase F — the attendance lock. Non-NULL means the teacher finalized the
  /// register: attendance is immutable to Teachers from then on, and the
  /// finalized ABSENT rows are the ONLY input to the absence-review workflow.
  attendanceFinalizedAt       DateTime?
  attendanceFinalizedByUserId String?
  /// Phase F — last material change to the event (metadata/link/timing).
  updatedAt DateTime? @updatedAt
  attendance   Attendance[]
  attendanceCorrections AttendanceCorrection[]
  absenceReviews AbsenceReview[]
  lesson       Lesson?       @relation(fields: [lessonId], references: [id])
  teacher      Teacher?      @relation(fields: [teacherId], references: [id])
  substituteTeacher Teacher? @relation("LiveSessionSubstitute", fields: [substituteTeacherId], references: [id], onDelete: SetNull)
  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([startAt])
  @@index([teacherId, startAt])
  @@index([substituteTeacherId])
  @@index([status, startAt])
}

/// Attendance — ONE row per (student × LiveSession): the attendance FACT.
///
/// Phase F rules encoded here:
///   * ABSENCE OF A ROW = UNMARKED. It is NOT `ABSENT` and never will be
///     silently converted: a teacher who forgets to finish the register does
///     not punish anybody (`UNMARKED ≠ ABSENT`).
///   * `AttendanceStatus` is the FACT (PRESENT/LATE/ABSENT/EXCUSED, the enum
///     already shipped). The ADMINISTRATIVE interpretation of a confirmed
///     absence (excused/unexcused/pending) lives in `AbsenceReview` — the two
///     concepts are deliberately separate tables.
///   * `markedByUserId`/`markedAt`/`updatedAt` record who last wrote the row
///     inside the attendance window; corrections after the lock are recorded
///     in `AttendanceCorrection` (never by rewriting history silently).
model Attendance {
  id        String           @id @default(cuid())
  studentId String
  sessionId String
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now())
  /// Phase F — who last marked this row and when (inside the open window).
  markedByUserId String?
  markedAt       DateTime?
  updatedAt      DateTime? @updatedAt
  session   LiveSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  corrections AttendanceCorrection[]
  /// Phase F — the administrative case opened from THIS absent row (1:1).
  absenceReview AbsenceReview?

  @@unique([studentId, sessionId])
  @@index([studentId])
  @@index([sessionId])
}

/// AttendanceCorrection — the ADMIN-only correction of a LOCKED attendance
/// row, with the full before/after state, a mandatory reason, the correcting
/// admin and the timestamp. Append-only: no UPDATE, no DELETE route exists,
/// and every row is mirrored into the platform `AuditLog`.
model AttendanceCorrection {
  id                String           @id @default(cuid())
  attendanceId      String
  sessionId         String
  studentId         String
  previousStatus    AttendanceStatus
  newStatus         AttendanceStatus
  reason            String
  correctedByUserId String
  correctedAt       DateTime         @default(now())
  attendance Attendance  @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  session    LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@index([sessionId])
}

/// AbsenceReview — the ADMINISTRATIVE case opened from a FINALIZED absence.
///
/// Phase F's separation of concerns in one table:
///   attendance fact     = `Attendance.status = ABSENT` (locked, immutable)
///   administrative view = this row (PENDING_REASON → PENDING_REVIEW →
///                         EXCUSED | UNEXCUSED, plus NO_ACTION_REQUIRED)
///
/// A case is created ONLY from finalized/locked attendance (never from a
/// temporary ABSENT click while the register is still editable), and exactly
/// once per attendance row (`attendanceId` is UNIQUE — the database-level
/// idempotency key of the whole workflow).
model AbsenceReview {
  id           String              @id @default(cuid())
  attendanceId String              @unique
  studentId    String
  sessionId    String
  groupId      String
  /// Denormalized curriculum reference (plain column, no relation): which
  /// academic Lesson the missed LiveSession belonged to at case-creation
  /// time. Phase H consumes it for catch-up access; a later re-link of the
  /// LiveSession must not rewrite open cases.
  lessonId     String?
  teacherId    String?
  status       AbsenceReviewStatus @default(PENDING_REASON)
  /// The CURRENT reason text (mirror of the newest submission — the full
  /// history is in `AbsenceReasonSubmission`, nothing is ever overwritten).
  reason              String?
  reasonSubmittedAt   DateTime?
  reasonSubmittedByUserId String?
  reasonSubmittedByRole   String?
  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime? @updatedAt
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session    LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submissions AbsenceReasonSubmission[]
  hold        AbsenceHold?

  @@index([status])
  @@index([studentId, status])
  @@index([sessionId])
  @@index([groupId])
}

/// AbsenceReasonSubmission — append-only history of reason submissions for a
/// case. A student AND a linked parent may submit (both recorded with their
/// own user id and role); a replacement never destroys the previous text.
model AbsenceReasonSubmission {
  id              String   @id @default(cuid())
  absenceReviewId String
  reason          String
  submittedByUserId String
  /// STUDENT | PARENT | ADMIN (the `Role` vocabulary of the platform).
  submittedByRole String
  createdAt       DateTime @default(now())
  absenceReview AbsenceReview @relation(fields: [absenceReviewId], references: [id], onDelete: Cascade)

  @@index([absenceReviewId, createdAt])
}

/// AbsenceHold — the authoritative Phase F OUTPUT consumed by Phase H.
///
/// Phase F creates/updates/resolves it, exposes it to authorized readers,
/// notifies and audits it. Phase F NEVER enforces it (no progression gate, no
/// content lock, no link block): that is Phase H's job.
///
///   UNEXCUSED absence → ACTIVE hold  (Phase H will block next-Lesson /
///                                    next-LiveSession-link / recordings and
///                                    grant catch-up access)
///   EXCUSED absence   → RESOLVED hold (administrative review closed; Phase H
///                                    still routes the student through the
///                                    missed session's own academic
///                                    requirements before progression — an
///                                    administrative approval is NOT academic
///                                    completion)
model AbsenceHold {
  id              String            @id @default(cuid())
  absenceReviewId String            @unique
  studentId       String
  sessionId       String
  status          AbsenceHoldStatus @default(ACTIVE)
  reason          String?
  createdAt       DateTime          @default(now())
  resolvedAt      DateTime?
  resolvedByUserId String?
  resolution      String?
  absenceReview AbsenceReview @relation(fields: [absenceReviewId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([sessionId])
}

/// ProgressionOverride — the Phase H ADMIN-ONLY progression exception.
///
/// WHY THIS TABLE EXISTS
///   The canonical progression engine (`src/lib/progression.ts`) derives
///   LOCKED / UNLOCKED / COMPLETED per student per lesson from academic facts
///   (video watch, quiz passes, homework submissions) sequenced over the
///   published, track-eligible curriculum, minus active absence holds. That
///   derivation is final for every role — except that an ADMIN may grant a
///   named student access to a named lesson as an audited, expirable, revocable
///   EXCEPTION, without rewriting any underlying fact.
///
/// WHAT IT IS
///   * ONE row grants access to ONE lesson for ONE student. It unlocks the
///     named lesson only: earlier lessons keep their own states, later lessons
///     still wait for the named lesson's derived completion.
///   * An override BYPASSES the sequential gate and an active absence-hold
///     boundary for the named lesson. It NEVER bypasses track isolation
///     (the grant route refuses a lesson outside the student's track), the
///     publication lifecycle (DRAFT/READY/archived lessons are ungrantable) or
///     enrollment/entitlement.
///   * It NEVER fabricates academic facts: no quiz pass, no homework
///     submission, no video completion, no attendance rewrite, no hold
///     destruction, no historical COMPLETED rewrite. The engine reports the
///     facts unchanged and marks the access as override-granted.
///
/// LIFECYCLE
///   ACTIVE  = revokedAt IS NULL AND (expiresAt IS NULL OR expiresAt > now).
///   EXPIRED = expiresAt <= now (evaluated at read time; no sweeper rewrites).
///   REVOKED = revokedAt IS NOT NULL (append-only; rows are never deleted).
///   Creation is idempotent per (student, lesson): re-granting an already
///   active override replays the existing row instead of duplicating it.
///
/// ACTOR COLUMNS (createdByUserId / revokedByUserId) are plain columns, NOT
/// relations — deleting a user must never rewrite override history (the same
/// policy as `SessionPublication.publishedByUserId` and the Phase F actor
/// columns). Every grant and revocation is mirrored into `AuditLog`.
model ProgressionOverride {
  id              String    @id @default(cuid())
  studentId       String
  lessonId        String
  /// Mandatory explicit reason, validated server-side (3..500 chars).
  reason          String
  createdByUserId String
  createdAt       DateTime  @default(now())
  /// Optional expiry. NULL = no expiry. Evaluated at read time.
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  revokeReason    String?
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([lessonId])
  @@index([studentId, lessonId])
}

model Quiz {
  id          String        @id @default(cuid())
  lessonId    String
  /// Phase 12 — track eligibility of the quiz itself, independent of (but
  /// never wider than) its lesson's trackScope. A LANGUAGE quiz on a SHARED
  /// lesson is served to LANGUAGE students only.
  trackScope  TrackScope    @default(SHARED)
  title       String
  titleAr     String
  description String?
  passMark    Int           @default(60)
  timeLimit   Int?
  order       Int           @default(0)

  // -------------------------------------------------------------------------
  // Phase G — QUIZ LIFECYCLE
  // -------------------------------------------------------------------------
  // Before Phase G a quiz was student-visible the instant it existed. Phase G
  // adds an authoring lifecycle WITHOUT a new enum (stored as TEXT, the same
  // convention as `quizMode` below and `QuizAttempt.status`):
  //   * `DRAFT`     — fully editable, invisible to students (a 404 on every
  //                   student surface) and excluded from progression.
  //   * `PUBLISHED` — student-visible through the existing lesson-unlock and
  //                   track gates; attempts may start.
  // Publishing is server-authoritative (`POST /api/teacher/quizzes/[id]/publish`)
  // and refuses a structurally invalid quiz (Phase 26D authority re-run).
  //
  // The default is `PUBLISHED` ON PURPOSE: every pre-Phase-G row keeps the
  // exact behaviour it always had (no draft limbo for live content); the
  // teacher create route writes `DRAFT` explicitly for new quizzes. Once any
  // attempt exists the question blueprint is immutable (see the Phase G lock
  // in src/app/api/teacher/questions/[id] and the question append route).

  /// `DRAFT` | `PUBLISHED`.
  status      String        @default("PUBLISHED")
  /// REQUIRED or OPTIONAL camera policy; legacy quizzes remain optional.
  cameraPolicy String      @default("OPTIONAL")
  /// First successful publish instant (null while the quiz is a draft).
  publishedAt DateTime?

  // -------------------------------------------------------------------------
  // Phase 26D — LESSON QUIZ BLUEPRINT
  // -------------------------------------------------------------------------
  // Before 26D a Quiz *was* its question list: every student received every
  // eligible question of the quiz, in the same order, forever. The blueprint
  // columns turn a Quiz into a SELECTION RULE over the Question Bank instead,
  // while `quizMode = "FIXED"` keeps the old behaviour byte-for-byte for every
  // quiz that already exists (see `resolveQuizBlueprint` in
  // src/lib/quiz-blueprint.ts — the single reader of these five columns).
  //
  // All five are ADDITIVE. A pre-26D row therefore reads
  // `FIXED / null / 1 / false / null`, which is exactly the behaviour that row
  // had before, except that `maxAttempts` is now 1 — the one-attempt default
  // is the whole point of the phase and is deliberately NOT opt-out.

  /// `FIXED` = freeze every eligible question (legacy). `BLUEPRINT` = the
  /// server selects `questionCount` questions per attempt from the pool,
  /// honouring `difficultyPlan`. Stored as TEXT like `QuizAttempt.cameraStatus`
  /// and `ExamAttempt.examType` — no new enum, no client-visible contract.
  quizMode        String        @default("FIXED")
  /// Requested question count for a BLUEPRINT quiz. NULL means "all eligible".
  questionCount   Int?
  /// How many attempts one student may ever hold on this quiz. ONE by default:
  /// starting the quiz consumes the entitlement. Only an Admin `QuizRetryGrant`
  /// raises the ceiling for a specific student — never a client-supplied value.
  maxAttempts     Int           @default(1)
  /// Optional answer-choice shuffle policy, applied server-side at freeze time
  /// (the frozen option order is snapshotted per attempt, so a refresh cannot
  /// reshuffle a running attempt).
  shuffleOptions  Boolean       @default(false)
  /// JSON difficulty plan, e.g. `{"EASY":2,"MEDIUM":3,"HARD":1}`. NULL = no
  /// difficulty constraint. Only meaningful in BLUEPRINT mode.
  difficultyPlan  String?

  questions   Question[]
  lesson      Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts    QuizAttempt[]
  retryGrants QuizRetryGrant[]

  @@index([lessonId])
}

model Question {
  id          String       @id @default(cuid())
  quizId      String?
  type        QuestionType @default(MCQ)
  prompt      String
  promptAr    String?
  options     String
  answer      String
  explanation String?
  difficulty  Difficulty   @default(MEDIUM)
  marks       Int          @default(1)
  schoolType  SchoolType?
  createdAt   DateTime     @default(now())
  quiz        Quiz?        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]
  mockExamLinks MockExamQuestion[]

  @@index([quizId])
  @@index([schoolType])
}

model QuizAttempt {
  id         String       @id @default(cuid())
  quizId     String
  studentId  String
  score      Int          @default(0)
  totalMarks Int          @default(0)
  percentage Int          @default(0)
  passed     Boolean      @default(false)
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  cameraStatus String     @default("NOT_REQUESTED")

  // -------------------------------------------------------------------------
  // Phase 26D — ATTEMPT SEQUENCE, STATE AND RETRY LINEAGE
  // -------------------------------------------------------------------------
  // Before 26D an attempt was identified only by `finishedAt IS NULL`, which
  // made "how many attempts has this student used" a derived count and left the
  // state machine implicit. These three columns make both explicit WITHOUT
  // reinterpreting any existing row: `finishedAt` remains the historical truth
  // and `status` is a projection of it, kept for queryability and for the one
  // state `finishedAt` cannot express on its own (EXPIRED).

  /// 1-based sequence of this attempt within (quiz, student). Server-computed;
  /// never accepted from a client. The unique index below is what makes
  /// "exactly one attempt #N" a database guarantee rather than a convention.
  attemptNumber Int        @default(1)
  /// `OPEN` | `SUBMITTED` | `EXPIRED`. `OPEN` ⇔ `finishedAt IS NULL`.
  status        String     @default("OPEN")
  /// The Admin grant that permitted this attempt beyond the first, if any.
  /// `onDelete: SetNull` so deleting a grant row can never delete history —
  /// the attempt and its score survive the loss of their lineage pointer.
  retryGrantId  String?

  answers    QuizAnswer[]
  evidence   QuizAttemptEvidence[]
  retryGrant QuizRetryGrant? @relation(fields: [retryGrantId], references: [id], onDelete: SetNull)
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz       Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId, attemptNumber])
  @@index([quizId, studentId])
  @@index([studentId])
}

model QuizAnswer {
  id         String      @id @default(cuid())
  attemptId  String
  questionId String
  selected   String
  isCorrect  Boolean     @default(false)

  // -------------------------------------------------------------------------
  // Phase 26D — FROZEN QUESTION SNAPSHOT
  // -------------------------------------------------------------------------
  // Phase 5 froze WHICH questions an attempt covers (these rows) but not WHAT
  // they said: prompt, options, the correct answer, marks and difficulty were
  // all read from the LIVE `Question` row at serve time and at grading time.
  // A Question Bank edit therefore silently rewrote a submitted result — the
  // stored `score` could disagree with the answer key the student was later
  // shown, and an option re-order invalidated an index-based `selected`.
  //
  // These columns are the fix. They are written ONCE, when the attempt's
  // question set is frozen at attempt start, and are never read from the live
  // bank again for that attempt.
  //
  // WHY EVERY COLUMN IS NULLABLE
  //   A pre-26D attempt has none of them. NULL means "no snapshot" and the
  //   reader falls back to the live `Question` row — i.e. EXACTLY the old
  //   behaviour, for exactly the rows that already relied on it. No backfill
  //   invention, no regrading of history, no destructive rewrite. Every attempt
  //   created after this migration is self-describing.
  //
  // `optionsSnapshot` is the FROZEN option order (JSON array) — when the quiz's
  // shuffle policy is on, it is the shuffled order this student saw, and
  // `answerSnapshot`/`selected` are indexes into THAT array, so grading a
  // historical attempt can never be invalidated by a later option edit.

  /// `orderIndex` — this question's position in the frozen attempt set.
  orderIndex          Int?
  questionType        String?
  promptSnapshot      String?
  promptArSnapshot    String?
  /// Frozen JSON array of option strings, in the order this attempt saw them.
  optionsSnapshot     String?
  /// Frozen correct answer (an index into `optionsSnapshot`).
  answerSnapshot      String?
  explanationSnapshot String?
  difficultySnapshot  String?
  marksSnapshot       Int?
  /// Frozen track tag; grading a historical attempt must not change because the
  /// live question was later retagged into another track.
  schoolTypeSnapshot  String?

  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  // One answer per (attempt, question). Phase 5: the attempt's question set
  // is persisted as QuizAnswer rows the moment the attempt is created, so a
  // student can never hold two rows for the same question of one attempt.
  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

/// Phase 26D — the ONLY mechanism by which a student may hold more than one
/// attempt on a Lesson Quiz.
///
/// WHY A MODEL AND NOT A COLUMN ON QuizAttempt
///   A retry is not a property of an attempt: it is a *permission issued before
///   the attempt exists*, by someone who is not the student, at a time that must
///   be recorded independently of the attempt. Modelling it as
///   `QuizAttempt.finishedAt = null` on the old row would destroy the result it
///   is granting a retry *from*; modelling it as a deleted row would destroy the
///   history outright. Both were explicitly rejected. This model adds a row and
///   touches nothing.
///
/// SEMANTICS
///   * ONE grant ⇒ exactly ONE extra attempt. `consumedAt` is written when the
///     student starts the new attempt, and a consumed grant can never be spent
///     again — the grant is a single-use token, not a flag.
///   * `grantedByUserId` + `grantedAt` make the decision attributable. Only an
///     ADMIN can create a row here (`/api/admin/quiz-retries`); a Teacher or a
///     Student gets a 403 and no row.
///   * Audited as `QUIZ_RETRY_GRANTED` in `AuditLog` at creation.
///   * `attempts` is the lineage back-link (`QuizAttempt.retryGrantId`), so an
///     inspection surface can show "attempt #3 was permitted by grant X, granted
///     by admin Y at time Z".
///   * `onDelete: SetNull` on the attempt side means pruning a grant never prunes
///     an attempt or a score.
model QuizRetryGrant {
  id          String    @id @default(cuid())
  studentId   String
  quizId      String
  grantedByUserId String
  grantedAt   DateTime  @default(now())
  /// NULL = still available. Non-NULL = spent by the attempt in `attempts`.
  consumedAt  DateTime?
  /// Optional, length-bounded by the API (RETRY_REASON_MAX). Never required.
  reason      String?

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  grantedBy   User     @relation("QuizRetryGrantGranter", fields: [grantedByUserId], references: [id], onDelete: Cascade)
  attempts    QuizAttempt[]

  @@index([studentId, quizId])
  @@index([quizId])
  @@index([grantedByUserId])
}

model Homework {
  id           String               @id @default(cuid())
  lessonId     String
  /// Phase 12 — track eligibility, same contract as Lesson/Quiz.trackScope.
  trackScope   TrackScope           @default(SHARED)
  title        String
  titleAr      String
  instructions String?
  deadline     DateTime
  maxMarks     Int                  @default(10)
  createdAt    DateTime             @default(now())

  // -------------------------------------------------------------------------
  // Phase G — HOMEWORK LIFECYCLE + TEACHER ATTACHMENT
  // -------------------------------------------------------------------------
  // `DRAFT → PUBLISHED → CLOSED`, stored as TEXT (the Phase 26D convention;
  // no new enum, no client-visible contract):
  //   * `DRAFT`     — teacher can fully edit; invisible to students (their
  //                   list, the progression universe and the submit gate all
  //                   skip it), so it can never be an unlock requirement.
  //   * `PUBLISHED` — visible to eligible students; submissions accepted and
  //                   classified ON_TIME/LATE against `deadline`.
  //   * `CLOSED`    — historically visible (list + grades stay readable); no
  //                   NEW student submission.
  // Transitions are server-authoritative (publish/close routes) and audited.
  //
  // The default is `PUBLISHED` ON PURPOSE: every pre-Phase-G row keeps its
  // exact behaviour; the teacher create route writes `DRAFT` explicitly.
  //
  // `attachmentId` links the teacher's assignment file (PDF/DOCX/PPTX/ZIP,
  // ≤25 MB) through the ONE existing private MediaAsset stack — no second
  // storage system. `SetNull` so removing an asset never destroys the
  // assignment itself.

  /// `DRAFT` | `PUBLISHED` | `CLOSED`.
  status       String               @default("PUBLISHED")
  /// Latest publish instant (set on DRAFT→PUBLISHED and on re-open).
  publishedAt  DateTime?
  attachmentId String?
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attachment   MediaAsset?          @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  submissions  HomeworkSubmission[]

  @@index([lessonId])
}

model HomeworkSubmission {
  id          String         @id @default(cuid())
  homeworkId  String
  studentId   String
  content     String?
  /// Legacy free-form pointer, superseded by `attachmentId` in Phase G. Kept
  /// because historical rows may carry it; new submissions never write it.
  fileUrl     String?
  submittedAt DateTime?
  grade       Int?
  feedback    String?
  status      HomeworkStatus @default(PENDING)

  // -------------------------------------------------------------------------
  // Phase G — STUDENT FILE + GRADER IDENTITY
  // -------------------------------------------------------------------------
  // `attachmentId` is the student's submitted file (PDF/DOCX/JPG/PNG/ZIP,
  // ≤25 MB) in the same private MediaAsset stack. `gradedById`/`gradedAt`
  // make a grade attributable (server-enforced 0 ≤ grade ≤ maxMarks); both
  // are nullable because pre-Phase-G grades exist without them and because
  // a teacher may pre-grade a student who never submitted.

  attachmentId String?
  gradedById   String?
  gradedAt     DateTime?
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  homework    Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  attachment  MediaAsset?    @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  gradedBy    User?          @relation("HomeworkGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

model ExamQuestion {
  id          String     @id @default(cuid())
  lessonId    String?
  examType    ExamType   @default(UNIT)
  prompt      String
  promptAr    String?
  options     String
  answer      String
  explanation String?
  difficulty  Difficulty @default(MEDIUM)
  marks       Int        @default(2)
  schoolType  SchoolType?
  lesson      Lesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mockExamLinks MockExamQuestion[]

  @@index([lessonId])
  @@index([schoolType])
}

model LessonProgress {
  id                  String    @id @default(cuid())
  studentId           String
  lessonId            String
  progress            Int       @default(0)
  isCompleted         Boolean   @default(false)
  lastViewedAt        DateTime?
  // --- video watch tracking (server-verified, monotonic) ---
  videoDurationSec    Int       @default(0)
  videoWatchedSec     Int       @default(0)
  videoPercent        Int       @default(0)
  videoCompleted      Boolean   @default(false)
  videoCompletedAt    DateTime?
  lastHeartbeatAt     DateTime?
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
  @@index([videoCompleted])
}

model TeacherNote {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  note      String
  createdAt DateTime @default(now())
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id             String         @id @default(cuid())
  name           String
  nameAr         String
  durationMonths Int
  price          Float
  isPromo        Boolean        @default(false)
  isActive       Boolean        @default(true)
  description    String?
  createdAt      DateTime       @default(now())
  subscriptions  Subscription[]
}

model Subscription {
  id        String             @id @default(cuid())
  studentId String             @unique
  planId    String
  status    SubscriptionStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  payments  Payment[]
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])
  student   Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Float
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  reference      String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  // Phase 25 PR1 (ledger only): nullable, no defaults, no relations.
  // New writers arrive in PR2a+; approval/review writers in PR3.
  senderPhone      String?
  requestedGroupId String?
  requestedPlanId  String?
  rejectionReason  String?
  reviewedAt       DateTime?
  reviewedByUserId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([subscriptionId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  /// Phase F — STRUCTURED SESSION PAYLOAD. When set, this notification is
  /// about a specific LiveSession and the UI renders the session actions
  /// (Join / Copy link) instead of a plain-text blob. It is a plain column
  /// (no relation): notifications are delivery history and must survive a
  /// session deletion, and the join URL itself is NEVER stored here — the
  /// client resolves it through the authorized
  /// `GET /api/live-sessions/[id]/join` endpoint, so an ineligible reader can
  /// never obtain a meeting link from their own notification row.
  sessionId String?
  /// Phase F — DETERMINISTIC IDEMPOTENCY KEY, unique per (user, key).
  /// Every Phase F emitter computes it from the EVENT IDENTITY (event type +
  /// subject id + the material revision of what changed), so a retried
  /// request, a double-submitted form or a re-run fan-out can never produce a
  /// second row for the same user. NULL (every pre-Phase-F row, and every
  /// notification that does not need idempotency) is exempt: SQLite and
  /// PostgreSQL both treat NULLs as distinct in a unique index.
  dedupeKey String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead])
  @@index([sessionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String?
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
